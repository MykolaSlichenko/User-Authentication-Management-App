{
  "compilerOptions": {
    "target": "ES2020",

    "module": "commonjs",
    "moduleResolution": "node",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "types": ["node", "jest"],

    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",

    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "prisma.config.ts"]
}